# Copiar a .env y sustituir los dos valores antes de iniciar.
DJANGO_SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_LARGA_ALEATORIA
POSTGRES_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA_LOCAL
POSTGRES_DB=aulastock
POSTGRES_USER=aulastock
APP_PORT=8000
# Variante del producto: A = básico (solo inventario), B = completo (inventario + reportes + notificaciones)
PRODUCT_VARIANT=B
# Una cantidad igual o menor a este valor genera alerta de stock bajo (solo variante B)
LOW_STOCK_THRESHOLD=5
